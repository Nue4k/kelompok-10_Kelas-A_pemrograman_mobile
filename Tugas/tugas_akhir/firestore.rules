rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOptionalString(value) {
      return value == null || value is string;
    }

    function isValidUserFullName(value) {
      return value is string && value.size() > 0 && value.size() <= 100;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'fullName',
          'email',
          'profilePicture',
          'phoneNumber',
          'createdAt'
        ])
        && isValidUserFullName(request.resource.data.fullName)
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && isOptionalString(request.resource.data.profilePicture)
        && isOptionalString(request.resource.data.phoneNumber)
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName',
          'profilePicture',
          'phoneNumber'
        ])
        && isValidUserFullName(request.resource.data.fullName)
        && isOptionalString(request.resource.data.profilePicture)
        && isOptionalString(request.resource.data.phoneNumber);

      allow delete: if false;
    }

    // Deny all other collections by default; granular rules will be added in Run 3-5.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
