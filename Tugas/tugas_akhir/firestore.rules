rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOptionalString(value) {
      return value == null || value is string;
    }

    function isValidUserFullName(value) {
      return value is string && value.size() > 0 && value.size() <= 100;
    }

    function workspaceDoc(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId);
    }

    function memberDoc(workspaceId, userId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(userId);
    }

    function isActiveMember(workspaceId) {
      return isSignedIn()
        && exists(memberDoc(workspaceId, request.auth.uid))
        && get(memberDoc(workspaceId, request.auth.uid)).data.status == 'active';
    }

    function isWorkspacePm(workspaceId) {
      return isActiveMember(workspaceId)
        && get(memberDoc(workspaceId, request.auth.uid)).data.role == 'pm';
    }

    function isValidWorkspaceName(value) {
      return value is string && value.size() > 0 && value.size() <= 100;
    }

    function isValidDescription(value) {
      return value == null || (value is string && value.size() <= 500);
    }

    function isValidInviteCode(value) {
      return value is string && value.size() == 8;
    }

    function isOptionalTimestamp(value) {
      return value == null || value is timestamp;
    }

    function isTargetActiveMember(workspaceId, userId) {
      return userId is string
        && exists(memberDoc(workspaceId, userId))
        && get(memberDoc(workspaceId, userId)).data.status == 'active';
    }

    function isValidTaskTitle(value) {
      return value is string && value.size() > 0 && value.size() <= 150;
    }

    function isValidTaskDescription(value) {
      return value == null || (value is string && value.size() <= 2000);
    }

    function isValidTaskPriority(value) {
      return value in ['low', 'medium', 'high'];
    }

    function isValidTaskDateRange(startDate, deadline) {
      return startDate == null || deadline == null || deadline >= startDate;
    }

    function isValidTaskStatusTransition(fromStatus, toStatus, isPm) {
      return (fromStatus == 'todo' && toStatus == 'in_progress')
        || (fromStatus == 'in_progress' && toStatus == 'in_review')
        || (fromStatus == 'revision' && toStatus == 'in_progress')
        || (isPm && fromStatus == 'in_review' && (toStatus == 'done' || toStatus == 'revision'));
    }

    function taskDoc(workspaceId, taskId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/tasks/$(taskId);
    }

    function isTaskPic(workspaceId, taskId) {
      return isActiveMember(workspaceId)
        && exists(taskDoc(workspaceId, taskId))
        && get(taskDoc(workspaceId, taskId)).data.picMemberId == request.auth.uid;
    }

    function isValidCommentText(value) {
      return value is string && value.size() > 0 && value.size() <= 2000;
    }

    function isValidAttachmentUrl(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 2048
        && value.matches('^https?://.+');
    }

    function isValidOptionalText(value, maxLen) {
      return value == null || (value is string && value.size() <= maxLen);
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'fullName',
          'email',
          'profilePicture',
          'phoneNumber',
          'createdAt'
        ])
        && isValidUserFullName(request.resource.data.fullName)
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && isOptionalString(request.resource.data.profilePicture)
        && isOptionalString(request.resource.data.phoneNumber)
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName',
          'profilePicture',
          'phoneNumber'
        ])
        && isValidUserFullName(request.resource.data.fullName)
        && isOptionalString(request.resource.data.profilePicture)
        && isOptionalString(request.resource.data.phoneNumber);

      allow delete: if false;

      match /notifications/{notificationId} {
        allow get, list: if isOwner(userId);

        allow create: if isSignedIn()
          && request.resource.data.keys().hasOnly([
            'userId',
            'workspaceId',
            'taskId',
            'type',
            'message',
            'isRead',
            'createdAt'
          ])
          && request.resource.data.userId == userId
          && isOptionalString(request.resource.data.workspaceId)
          && isOptionalString(request.resource.data.taskId)
          && (
            isOwner(userId)
            || (
              request.resource.data.workspaceId is string
              && isActiveMember(request.resource.data.workspaceId)
              && isTargetActiveMember(request.resource.data.workspaceId, userId)
            )
          )
          && request.resource.data.type is string
          && request.resource.data.type.size() > 0
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 500
          && request.resource.data.isRead == false
          && request.resource.data.createdAt == request.time;

        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
          && request.resource.data.isRead is bool;

        allow delete: if false;
      }
    }

    match /inviteCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'workspaceId',
          'createdBy',
          'createdAt'
        ])
        && request.resource.data.workspaceId is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (
          isWorkspacePm(request.resource.data.workspaceId)
          || getAfter(workspaceDoc(request.resource.data.workspaceId)).data.createdBy == request.auth.uid
        );

      allow update: if false;
      allow delete: if isWorkspacePm(resource.data.workspaceId);
    }

    match /workspaces/{workspaceId} {
      allow get: if isActiveMember(workspaceId);
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'workspaceName',
          'description',
          'inviteCode',
          'status',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && isValidWorkspaceName(request.resource.data.workspaceName)
        && isValidDescription(request.resource.data.description)
        && isValidInviteCode(request.resource.data.inviteCode)
        && request.resource.data.status == 'active'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isWorkspacePm(workspaceId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'workspaceName',
          'description',
          'inviteCode',
          'status',
          'updatedAt'
        ])
        && isValidWorkspaceName(request.resource.data.workspaceName)
        && isValidDescription(request.resource.data.description)
        && isValidInviteCode(request.resource.data.inviteCode)
        && request.resource.data.status in ['active', 'archived']
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /members/{userId} {
        allow get: if isActiveMember(workspaceId) || isOwner(userId);
        allow list: if isActiveMember(workspaceId);

        allow create: if request.resource.data.keys().hasOnly([
            'workspaceId',
            'userId',
            'role',
            'status',
            'joinedAt',
            'removedAt'
          ])
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.userId == userId
          && request.resource.data.status == 'active'
          && request.resource.data.joinedAt == request.time
          && request.resource.data.removedAt == null
          && (
            (
              isOwner(userId)
              && request.resource.data.role == 'pm'
              && getAfter(workspaceDoc(workspaceId)).data.createdBy == request.auth.uid
            )
            || (
              isWorkspacePm(workspaceId)
              && request.resource.data.role == 'member'
            )
          );

        allow update: if (
            isWorkspacePm(workspaceId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'role',
              'status',
              'joinedAt',
              'removedAt'
            ])
            && request.resource.data.role in ['pm', 'member']
            && request.resource.data.status in ['active', 'removed']
          ) || (
            isOwner(userId)
            && resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'removedAt'
            ])
            && request.resource.data.status == 'removed'
            && request.resource.data.removedAt == request.time
          );

        allow delete: if false;
      }

      match /joinRequests/{userId} {
        allow get: if isOwner(userId) || isWorkspacePm(workspaceId);
        allow list: if isWorkspacePm(workspaceId);

        allow create: if isOwner(userId)
          && !isActiveMember(workspaceId)
          && exists(workspaceDoc(workspaceId))
          && get(workspaceDoc(workspaceId)).data.status == 'active'
          && request.resource.data.keys().hasOnly([
            'workspaceId',
            'userId',
            'status',
            'requestedAt',
            'reviewedAt',
            'reviewedBy'
          ])
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.userId == userId
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedAt == request.time
          && request.resource.data.reviewedAt == null
          && request.resource.data.reviewedBy == null;

        allow update: if (
            isWorkspacePm(workspaceId)
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'reviewedAt',
              'reviewedBy'
            ])
            && request.resource.data.status in ['approved', 'rejected']
            && request.resource.data.reviewedAt == request.time
            && request.resource.data.reviewedBy == request.auth.uid
          ) || (
            isOwner(userId)
            && !isActiveMember(workspaceId)
            && resource.data.status != 'pending'
            && exists(workspaceDoc(workspaceId))
            && get(workspaceDoc(workspaceId)).data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'requestedAt',
              'reviewedAt',
              'reviewedBy'
            ])
            && request.resource.data.status == 'pending'
            && request.resource.data.requestedAt == request.time
            && request.resource.data.reviewedAt == null
            && request.resource.data.reviewedBy == null
          );

        allow delete: if false;
      }

      match /tasks/{taskId} {
        allow get, list: if isActiveMember(workspaceId);

        allow create: if isWorkspacePm(workspaceId)
          && request.resource.data.keys().hasOnly([
            'workspaceId',
            'picMemberId',
            'createdBy',
            'title',
            'description',
            'startDate',
            'deadline',
            'priority',
            'status',
            'archivedAt',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.createdBy == request.auth.uid
          && isTargetActiveMember(workspaceId, request.resource.data.picMemberId)
          && isValidTaskTitle(request.resource.data.title)
          && isValidTaskDescription(request.resource.data.description)
          && isOptionalTimestamp(request.resource.data.startDate)
          && isOptionalTimestamp(request.resource.data.deadline)
          && isValidTaskDateRange(
            request.resource.data.startDate,
            request.resource.data.deadline
          )
          && isValidTaskPriority(request.resource.data.priority)
          && request.resource.data.status == 'todo'
          && request.resource.data.archivedAt == null
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if (
            isWorkspacePm(workspaceId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'picMemberId',
              'title',
              'description',
              'startDate',
              'deadline',
              'priority',
              'status',
              'archivedAt',
              'updatedAt'
            ])
            && request.resource.data.updatedAt == request.time
            && isValidTaskTitle(request.resource.data.title)
            && isValidTaskDescription(request.resource.data.description)
            && isOptionalTimestamp(request.resource.data.startDate)
            && isOptionalTimestamp(request.resource.data.deadline)
            && isValidTaskDateRange(
              request.resource.data.startDate,
              request.resource.data.deadline
            )
            && isValidTaskPriority(request.resource.data.priority)
            && isOptionalTimestamp(request.resource.data.archivedAt)
            && (
              request.resource.data.picMemberId == resource.data.picMemberId
              || isTargetActiveMember(workspaceId, request.resource.data.picMemberId)
            )
            && (
              request.resource.data.archivedAt == resource.data.archivedAt
              || request.resource.data.archivedAt == null
              || request.resource.data.archivedAt == request.time
            )
            && (
              request.resource.data.status == resource.data.status
              || (
                resource.data.archivedAt == null
                && request.resource.data.archivedAt == null
                && isValidTaskStatusTransition(
                  resource.data.status,
                  request.resource.data.status,
                  true
                )
              )
            )
          ) || (
            isActiveMember(workspaceId)
            && resource.data.picMemberId == request.auth.uid
            && resource.data.archivedAt == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'updatedAt'
            ])
            && request.resource.data.updatedAt == request.time
            && isValidTaskStatusTransition(
              resource.data.status,
              request.resource.data.status,
              false
            )
          );

        allow delete: if false;

        match /comments/{commentId} {
          allow get, list: if isActiveMember(workspaceId);

          allow create: if isActiveMember(workspaceId)
            && request.resource.data.keys().hasOnly([
              'taskId',
              'userId',
              'commentText',
              'createdAt',
              'updatedAt'
            ])
            && request.resource.data.taskId == taskId
            && request.resource.data.userId == request.auth.uid
            && isValidCommentText(request.resource.data.commentText)
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time;

          allow update: if isActiveMember(workspaceId)
            && resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'commentText',
              'updatedAt'
            ])
            && isValidCommentText(request.resource.data.commentText)
            && request.resource.data.updatedAt == request.time;

          allow delete: if isWorkspacePm(workspaceId)
            || (isActiveMember(workspaceId) && resource.data.userId == request.auth.uid);
        }

        match /attachments/{attachmentId} {
          allow get, list: if isActiveMember(workspaceId);

          allow create: if isActiveMember(workspaceId)
            && request.resource.data.keys().hasOnly([
              'taskId',
              'uploadedBy',
              'fileUrl',
              'uploadedAt'
            ])
            && request.resource.data.taskId == taskId
            && request.resource.data.uploadedBy == request.auth.uid
            && isValidAttachmentUrl(request.resource.data.fileUrl)
            && request.resource.data.uploadedAt == request.time;

          allow update: if false;

          allow delete: if isWorkspacePm(workspaceId)
            || (isActiveMember(workspaceId) && resource.data.uploadedBy == request.auth.uid);
        }

        match /statusHistory/{historyId} {
          allow get, list: if isActiveMember(workspaceId);

          allow create: if (isWorkspacePm(workspaceId) || isTaskPic(workspaceId, taskId))
            && request.resource.data.keys().hasOnly([
              'taskId',
              'changedBy',
              'oldStatus',
              'newStatus',
              'notes',
              'changedAt'
            ])
            && request.resource.data.taskId == taskId
            && request.resource.data.changedBy == request.auth.uid
            && (
              request.resource.data.oldStatus == null
              || request.resource.data.oldStatus in ['todo', 'in_progress', 'in_review', 'revision', 'done']
            )
            && request.resource.data.newStatus in ['todo', 'in_progress', 'in_review', 'revision', 'done']
            && isValidOptionalText(request.resource.data.notes, 2000)
            && request.resource.data.changedAt == request.time;

          allow update, delete: if false;
        }

        match /reviews/{reviewId} {
          allow get, list: if isActiveMember(workspaceId);

          allow create: if (isWorkspacePm(workspaceId) || isTaskPic(workspaceId, taskId))
            && request.resource.data.keys().hasOnly([
              'taskId',
              'submittedBy',
              'reviewedBy',
              'decision',
              'feedback',
              'submittedAt',
              'reviewedAt'
            ])
            && request.resource.data.taskId == taskId
            && request.resource.data.submittedBy == request.auth.uid
            && request.resource.data.reviewedBy == null
            && request.resource.data.decision == null
            && request.resource.data.feedback == null
            && request.resource.data.submittedAt == request.time
            && request.resource.data.reviewedAt == null;

          allow update: if isWorkspacePm(workspaceId)
            && resource.data.decision == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'reviewedBy',
              'decision',
              'feedback',
              'reviewedAt'
            ])
            && request.resource.data.reviewedBy == request.auth.uid
            && request.resource.data.decision in ['approved', 'revision']
            && isValidOptionalText(request.resource.data.feedback, 2000)
            && (
              request.resource.data.decision == 'approved'
              || (
                request.resource.data.feedback is string
                && request.resource.data.feedback.size() > 0
              )
            )
            && request.resource.data.reviewedAt == request.time;

          allow delete: if false;
        }

        match /picChangeRequests/{requestId} {
          allow get, list: if isActiveMember(workspaceId);

          allow create: if isActiveMember(workspaceId)
            && request.resource.data.keys().hasOnly([
              'taskId',
              'requestedBy',
              'currentPicId',
              'proposedPicId',
              'status',
              'reason',
              'requestedAt',
              'reviewedBy',
              'reviewedAt'
            ])
            && request.resource.data.taskId == taskId
            && request.resource.data.requestedBy == request.auth.uid
            && request.resource.data.currentPicId is string
            && request.resource.data.currentPicId.size() > 0
            && request.resource.data.proposedPicId != request.resource.data.currentPicId
            && isTargetActiveMember(workspaceId, request.resource.data.proposedPicId)
            && request.resource.data.status == 'pending'
            && isValidOptionalText(request.resource.data.reason, 500)
            && request.resource.data.requestedAt == request.time
            && request.resource.data.reviewedBy == null
            && request.resource.data.reviewedAt == null;

          allow update: if isWorkspacePm(workspaceId)
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'reviewedBy',
              'reviewedAt'
            ])
            && request.resource.data.status in ['approved', 'rejected']
            && request.resource.data.reviewedBy == request.auth.uid
            && request.resource.data.reviewedAt == request.time;

          allow delete: if false;
        }

        match /assignmentHistory/{historyId} {
          allow get, list: if isActiveMember(workspaceId);

          allow create: if isWorkspacePm(workspaceId)
            && request.resource.data.keys().hasOnly([
              'taskId',
              'oldPicId',
              'newPicId',
              'changedBy',
              'reason',
              'changedAt'
            ])
            && request.resource.data.taskId == taskId
            && isOptionalString(request.resource.data.oldPicId)
            && isTargetActiveMember(workspaceId, request.resource.data.newPicId)
            && request.resource.data.changedBy == request.auth.uid
            && isValidOptionalText(request.resource.data.reason, 500)
            && request.resource.data.changedAt == request.time;

          allow update, delete: if false;
        }
      }

      match /activityLogs/{logId} {
        allow get, list: if isActiveMember(workspaceId);

        allow create: if isActiveMember(workspaceId)
          && request.resource.data.keys().hasOnly([
            'workspaceId',
            'userId',
            'taskId',
            'activityType',
            'description',
            'createdAt'
          ])
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.userId == request.auth.uid
          && isOptionalString(request.resource.data.taskId)
          && request.resource.data.activityType is string
          && request.resource.data.activityType.size() > 0
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0
          && request.resource.data.description.size() <= 500
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    match /{path=**}/members/{userId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Deny all other collections by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
